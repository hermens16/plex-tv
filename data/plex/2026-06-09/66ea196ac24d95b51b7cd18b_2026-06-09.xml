l Desprecio" grandparentType="show" index="54" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://cdn-images.watch4.com/1080/3/1672731.jpg" title="S01:E54" userState="0"><Image alt="S01:E54" type="coverArt" url="https://cdn-images.watch4.com/1080/3/1672731.jpg"/><Image alt="S01:E54" type="coverPoster" url="https://cdn-images.watch4.com/1920/2/1672731.jpg"/><Image alt="S01:E54" type="snapshot" url="https://cdn-images.watch4.com/1080/3/1672731.jpg"/><Genre filter="genre=6a0c2728768cf9b31f6fe02a" id="6a0c2728768cf9b31f6fe02a" key="/library/sections/home/all?genre=6a0c2728768cf9b31f6fe02a" ratingKey="genre_6a0c2728768cf9b31f6fe02a" slug="bingeworthy" tag="Bingeworthy" type="directory" context="tag.genre"/><Media beginsAt="1780967607" duration="2591000" endsAt="1780970198" id="6a1d7c1dbe2d3e676855bfc3" onAir="0" premiere="0" videoResolution="720" origin="livetv"/><Media beginsAt="1780991304" duration="2592000" endsAt="1780993896" id="6a1ecd1ce0971a8937b4e484" onAir="0" premiere="0" videoResolution="720" origin="livetv"/><Media beginsAt="1781020990" duration="2457000" endsAt="1781023447" id="6a1ecd1ce0971a8937b4e48e" onAir="0" premiere="0" videoResolution="720" origin="livetv"/></Video><Video guid="plex://episode/6a1d7c1bbe2d3e676855bfa2" key="/library/metadata/6a1d7c1bbe2d3e676855bfa2" ratingKey="6a1d7c1bbe2d3e676855bfa2" summary="Para decidir quién comprará las yeguas, Florencia reta a Victoria a una carrera por el llano donde la ganadora se quedará con los animales; Victoria acepta el desafío. Una inesperada visita de Hilario asusta a Federico, mientras que Fernanda no se amilana y le recuerda a su medio hermano que Victoria es quien lo está dejando en la ruina; Hilario le asegura a Fernanda que no permitirá que su propia hija lo despoje de lo que le pertenece. En medio de la carrera, Florencia desenfunda su arma y dispara al viento para obligar a Victoria a detenerse; esta última se extraña al ver a la señora Del Casal armada, dispuesta a matar, pero Florencia es incapaz de seguir su plan, por lo que decide terminar la carrera. Frente a un confundido Nicolás, Victoria irrumpe en la hacienda Los Samanes para exigirle a Florencia una explicación sobre el por qué ésta cavó una fosa cerca del lugar donde disparó durante la carrera: debido a que Florencia niega su participación en la excavación, Victoria arremete en contra de ella para que confiese su intención de asesinarla." type="episode" contentRating="NONADULT" duration="3077000" grandparentArt="https://cdn-images.watch4.com/1080/3/1766385.jpg" grandparentGuid="plex://show/67a0b759cb3d68c83b1e7d4f" grandparentKey="/library/metadata/67a0b759cb3d68c83b1e7d4f" grandparentRatingKey="67a0b759cb3d68c83b1e7d4f" grandparentThumb="https://cdn-images.watch4.com/1920/2/1766385.jpg" grandparentTitle="La Trepadora" grandparentType="show" index="101" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://cdn-images.watch4.com/1080/3/1766385.jpg" title="S01:E101" userState="0"><Image alt="S01:E101" type="coverArt" url="https://cdn-images.watch4.com/1080/3/1766385.jpg"/><Image alt="S01:E101" type="coverPoster" url="https://cdn-images.watch4.com/1920/2/1766385.jpg"/><Image alt="S01:E101" type="snapshot" url="https://cdn-images.watch4.com/1080/3/1766385.jpg"/><Genre filter="genre=6a0c2728768cf9b31f6fe02a" id="6a0c2728768cf9b31f6fe02a" key="/library/sections/home/all?genre=6a0c2728768cf9b31f6fe02a" ratingKey="genre_6a0c2728768cf9b31f6fe02a" slug="bingeworthy" tag="Bingeworthy" type="directory" context="tag.genre"/><Media beginsAt="1781008498" duration="3077000" endsAt="1781011575" id="6a1ecd1ce0971a8937b4e48a" onAir="0" premiere="0" videoResolution="720" origin="livetv"/><Media beginsAt="1781038513" duration="3077000" endsAt="1781041590" id="6a1ecd1ce0971a8937b4e494" onAir="0" premiere="0" videoResolution="720" origin="livetv"/></Video><Video guid="plex://episode/6a1d7c1cbe2d3e676855bfa3" key="/library/metadata/6a1d7c1cbe2d3e676855bfa3" ratingKey="6a1d7c1cbe2d3e676855bfa3