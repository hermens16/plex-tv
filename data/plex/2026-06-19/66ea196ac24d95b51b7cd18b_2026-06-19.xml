1862861" duration="3105000" endsAt="1781865966" id="6a2ca4fb521fe94eff27af46" onAir="0" premiere="0" videoResolution="720" origin="livetv"/><Media beginsAt="1781892735" duration="3104000" endsAt="1781895839" id="6a2ca4fb521fe94eff27af50" onAir="0" premiere="0" videoResolution="720" origin="livetv"/></Video><Video guid="plex://episode/6a2ca4fa521fe94eff27af3d" key="/library/metadata/6a2ca4fa521fe94eff27af3d" ratingKey="6a2ca4fa521fe94eff27af3d" summary="El inspector Torrealba exige que Rosa declare sobre lo sucedido en el pasado crimen de Leoncio López Méndez. Con dolor revive los momentos en que llegó Ezequiel y asesinó a Leoncio y luego, se retiró del lugar sin ninguna clase de remordimiento. Fausto y Ezequiel continúan con su plan de asesinar a Rosa Blanco para que no cuente lo que sabe." type="episode" contentRating="NONADULT" duration="3124000" grandparentArt="https://cdn-images.watch4.com/1080/3/1672724.jpg" grandparentGuid="plex://show/66ea19708651b52ba9cee047" grandparentKey="/library/metadata/66ea19708651b52ba9cee047" grandparentRatingKey="66ea19708651b52ba9cee047" grandparentThumb="https://cdn-images.watch4.com/1920/2/1672724.jpg" grandparentTitle="Piel Salvaje" grandparentType="show" index="113" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://cdn-images.watch4.com/1080/3/1672724.jpg" title="S01:E113" userState="0"><Image alt="S01:E113" type="coverArt" url="https://cdn-images.watch4.com/1080/3/1672724.jpg"/><Image alt="S01:E113" type="coverPoster" url="https://cdn-images.watch4.com/1920/2/1672724.jpg"/><Image alt="S01:E113" type="snapshot" url="https://cdn-images.watch4.com/1080/3/1672724.jpg"/><Genre filter="genre=6a0c2728768cf9b31f6fe02a" id="6a0c2728768cf9b31f6fe02a" key="/library/sections/home/all?genre=6a0c2728768cf9b31f6fe02a" ratingKey="genre_6a0c2728768cf9b31f6fe02a" slug="bingeworthy" tag="Bingeworthy" type="directory" context="tag.genre"/><Media beginsAt="1781869146" duration="3124000" endsAt="1781872270" id="6a2ca4fb521fe94eff27af48" onAir="0" premiere="0" videoResolution="720" origin="livetv"/><Media beginsAt="1781899020" duration="3123000" endsAt="1781902143" id="6a2ca4fb521fe94eff27af52" onAir="0" premiere="0" videoResolution="720" origin="livetv"/></Video><Video guid="plex://episode/6a2ca4fb521fe94eff27af3f" key="/library/metadata/6a2ca4fb521fe94eff27af3f" ratingKey="6a2ca4fb521fe94eff27af3f" summary="Justo cuando Victoria le impide a Sergio anunciar su compromiso frente a la familia Guanipa, Sergio cree que la mujer se arrepintió; Victoria es quien anuncia su matrimonio, lo que sorprende a todos. Adelaida en compañía de Hansen, recuerda la niñez de su hija Victoria, quien desde pequeña ha sido traviesa; la sensación de tener a su hija en peligro y no poder hacer nada despertó en ella un sentimiento más grande. Victoria evita los besos de Sergio, quien se apresura por ponerle fecha a su matrimonio; Sergio ya ha preparado todo para casarse en una semana." type="episode" contentRating="NONADULT" duration="3055000" grandparentArt="https://cdn-images.watch4.com/1080/3/1766385.jpg" grandparentGuid="plex://show/67a0b759cb3d68c83b1e7d4f" grandparentKey="/library/metadata/67a0b759cb3d68c83b1e7d4f" grandparentRatingKey="67a0b759cb3d68c83b1e7d4f" grandparentThumb="https://cdn-images.watch4.com/1920/2/1766385.jpg" grandparentTitle="La Trepadora" grandparentType="show" index="113" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://cdn-images.watch4.com/1080/3/1766385.jpg" title="S01:E113" userState="0"><Image alt="S01:E113" type="coverArt" url="https://cdn-images.watch4.com/1080/3/1766385.jpg"/><Image alt="S01:E113" type="coverPoster" url="https://cdn-images.watch4.com/1920/2/1766385.jpg"/><Image alt="S01:E113" type="snapshot" url="https://cdn-images.watch4.com/1080/3/1766385.jpg"/><Genre filter="genre=6a0c2728768cf9b31f6fe02a" id="6a0c2728768cf9b31f6fe02a" key="/library/sections/home/all?genre=6a0c2728768cf9b31f6fe02a" ratingKey="genre_6a0c2728768cf9b31f6fe02a" slug="bingeworthy" tag="Bingeworthy" type="directory" context="tag.genre"/><Media beginsAt="1781872270" duration="3055000" endsAt="1781875325" id="6a2ca4fb521fe94eff27af49" onAir="0" premiere="0" videoResolution="720" origin="livetv"/><Media beginsAt="1781902143" duration="3055000" endsAt="1781905198" id="6a2ca4fb521fe94eff27af53" onAir="0" premiere="0" videoResolution="720" origin="livetv"/></Video><Video guid="plex://episode/6a2ca4fb521fe94eff27af40" key="/library/metadata/6a2ca4fb521fe94eff27af40" ratingKey="6a2ca4fb521fe94eff27af40" summary="Ante la insistencia de Sergio por apresurar la boda, Victoria trata de convencerlo de esperar un tiempo, pero no tiene motivos para no adelantar su boda, así que Victoria acepta casarse en una semana. A escondidas, Nicolás escucha cuando Florencia le advierte a Fernanda so miedo de perder a su esposo, porque si no fuera por la trampa que ambas fraguaron ya Nicolás la hubiese abandonado; un indignado Nicolás las enfrenta, pues no puede creer que su tía y su esposa lo hayan engañado para impedir su matrimonio con Victoria. A solas con su esposa, Nicolás entiende como Florencia lo vio sufrir por Victoria y aún así lo traicionó, así que Nicolás decide separarse de ella; Florencia no quiere ser condenada por un error, pero Nicolás admite que su error es haberse casado con ella. El miedo embarga a Victoria por su nueva vida junto a su futuro esposo, Sergio, pero Adelaida apoya la decisión de su hija; En un nuevo día, cuando Victoria le afirma a su madre que siente una necesidad de huir de sus sentimientos por Nicolás, Adelaida se le impone, pues no apoyará a su hija en la decisión de casarse, pues le aconseja hablar con Sergio y cancelar el matrimonio." type="episode" contentRating="NONADULT" duration="3071000" grandparentArt="https://cdn-images.watch4.com/1080/3/1766385.jpg" grandparentGuid="plex://show/67a0b759cb3d68c83b1e7d4f" grandparentKey="/library/metadata/67a0b759cb3d68c83b1e7d4f" grandparentRatingKey="67a0b759cb3d68c83b1e7d4f" grandparentThumb="https://cdn-images.watch4.com/1920/2/1766385.jpg" grandparentTitle="La Trepadora" grandparentType="show" index="114" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://cdn-images.watch4.com/1080/3/1766385.jpg" title="S01:E114" userState="0"><Image alt="S01:E114" type="coverArt" url="https://cdn-images.watch4.com/1080/3/1766385.jpg"/><Image alt="S01:E114" type="coverPoster" url="https://cdn-images.watch4.com/1920/2/1766385.jpg"/><Image alt="S01:E114" type="snapshot" url="https://cdn-images.watch4.com/1080/3/1766385.jpg"/><Genre filter="genre=6a0c2728768cf9b31f6fe02a" id="6a0c2728768cf9b31f6fe02a" key="/library/sections/home/all?genre=6a0c2728768cf9b31f6fe02a" ratingKey="genre_6a0c2728768cf9b31f6fe02a" slug="bingeworthy" tag="Bingeworthy" type="directory" context="tag.genre"/><Media beginsAt="1781875325" duration="3071000" endsAt="1781878396" id="6a2ca4fb521fe94eff27af4a" onAir="0" premiere="0" videoResolution="720" origin="livetv"/><Media beginsAt="1781905198" duration="3072000" endsAt="1781908270" id="6a2ca4fb521fe94eff27af54" onAir="0" premiere="0" videoResolution="720" origin="livetv"/></Video></MediaContainer>
