atch4.com/1080/3/1672724.jpg" title="S01:E01" userState="0"><Image alt="S01:E01" type="coverArt" url="https://cdn-images.watch4.com/1080/3/1672724.jpg"/><Image alt="S01:E01" type="coverPoster" url="https://cdn-images.watch4.com/1920/2/1672724.jpg"/><Image alt="S01:E01" type="snapshot" url="https://cdn-images.watch4.com/1080/3/1672724.jpg"/><Genre filter="genre=6a0c2728768cf9b31f6fe02a" id="6a0c2728768cf9b31f6fe02a" key="/library/sections/home/all?genre=6a0c2728768cf9b31f6fe02a" ratingKey="genre_6a0c2728768cf9b31f6fe02a" slug="bingeworthy" tag="Bingeworthy" type="directory" context="tag.genre"/><Media beginsAt="1782560249" duration="3183000" endsAt="1782563432" id="6a368897001c1003da5c5598" onAir="1" premiere="0" videoResolution="720" origin="livetv"/><Media beginsAt="1782590117" duration="3182000" endsAt="1782593299" id="6a368897001c1003da5c55a2" onAir="0" premiere="0" videoResolution="720" origin="livetv"/></Video><Video guid="plex://episode/6a368897001c1003da5c5589" key="/library/metadata/6a368897001c1003da5c5589" ratingKey="6a368897001c1003da5c5589" summary="Mientras Victoria le agradece a Sergio por todo su apoyo en esclarecer la muerte de Genara, Sergio lamenta seguir mintiéndole a Guanipa sobre el golpe que recibió Nicolás en el rescate de su secuestro. Caída la noche, Fernanda quiere asegurarse de que Florencia no la traicione ahora que Moncho declarará a la policía haberla visto en el mismo lugar y el mismo día en que Genara fue asesinada. Al siguiente día, Victoria se presenta en la hacienda Los Samanes para evitar que Florencia huya de la justicia, pues la joven Guanipa está convencida de que Florencia es culpable de la muerte de Genara; Nicolás defiende el honor de su esposa al asegurar que Moncho miente en su declaración.Después de un día en la jefatura ofreciendo declaraciones, Florencia se comunica con Fernanda para pedirle ayuda, pues necesita revelarle a Nicolás que pedió a su hijo sin poner en riesgo su matrimonio. En un nuevo día, Nicolás se presenta en la oficina de Sergio para entregarle a Victoria los resultados de los exámenes de ADN donde se demuestra la inocencia de Florencia y Fernanda; una sorprendida Victoria cree que todo es mentira, pero Nicolás le aconseja dejar que la justicia se encargue de castigar al verdadero asesino." type="episode" contentRating="NONADULT" duration="3060000" grandparentArt="https://cdn-images.watch4.com/1080/3/1766385.jpg" grandparentGuid="plex://show/67a0b759cb3d68c83b1e7d4f" grandparentKey="/library/metadata/67a0b759cb3d68c83b1e7d4f" grandparentRatingKey="67a0b759cb3d68c83b1e7d4f" grandparentThumb="https://cdn-images.watch4.com/1920/2/1766385.jpg" grandparentTitle="La Trepadora" grandparentType="show" index="122" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://cdn-images.watch4.com/1080/3/1766385.jpg" title="S01:E122" userState="0"><Image alt="S01:E122" type="coverArt" url="https://cdn-images.watch4.com/1080/3/1766385.jpg"/><Image alt="S01:E122" type="coverPoster" url="https://cdn-images.watch4.com/1920/2/1766385.jpg"/><Image alt="S01:E122" type="snapshot" url="https://cdn-images.watch4.com/1080/3/1766385.jpg"/><Genre filter="genre=6a0c2728768cf9b31f6fe02a" id="6a0c2728768cf9b31f6fe02a" key="/library/sections/home/all?genre=6a0c2728768cf9b31f6fe02a" ratingKey="genre_6a0c2728768cf9b31f6fe02a" slug="bingeworthy" tag="Bingeworthy" type="directory" context="tag.genre"/><Media beginsAt="1782566490" duration="3060000" endsAt="1782569550" id="6a368897001c1003da5c559a" onAir="0" premiere="0" videoResolution="720" origin="livetv"/><Media beginsAt="1782596357" duration="3061000" endsAt="1782599418" id="6a368897001c1003da5c55a4" onAir="0" premiere="0" videoResolution="720" origin="livetv"/></Video></MediaContainer>
