.watch4.com/1920/2/1672730.jpg" grandparentTitle="Te Tengo en Salsa" grandparentType="show" index="9" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://cdn-images.watch4.com/1080/3/1672730.jpg" title="S01:E09" userState="0"><Image alt="S01:E09" type="coverArt" url="https://cdn-images.watch4.com/1080/3/1672730.jpg"/><Image alt="S01:E09" type="coverPoster" url="https://cdn-images.watch4.com/1920/2/1672730.jpg"/><Image alt="S01:E09" type="snapshot" url="https://cdn-images.watch4.com/1080/3/1672730.jpg"/><Genre filter="genre=6a0c2728768cf9b31f6fe02a" id="6a0c2728768cf9b31f6fe02a" key="/library/sections/home/all?genre=6a0c2728768cf9b31f6fe02a" ratingKey="genre_6a0c2728768cf9b31f6fe02a" slug="bingeworthy" tag="Bingeworthy" type="directory" context="tag.genre"/><Media beginsAt="1783072553" duration="3101000" endsAt="1783075654" id="6a3e7173e2c04503f66caa8d" onAir="0" premiere="0" videoResolution="720" origin="livetv"/><Media beginsAt="1783102590" duration="3100000" endsAt="1783105690" id="6a3e7173e2c04503f66caa97" onAir="0" premiere="0" videoResolution="720" origin="livetv"/></Video><Video guid="plex://episode/6a3e7173e2c04503f66caa80" key="/library/metadata/6a3e7173e2c04503f66caa80" ratingKey="6a3e7173e2c04503f66caa80" summary="Convencido de que Hilario necesitaba intimidarlo para no seguir investigando sobre la muerte de su padre, Nicolás acusa a Guanipa de haberle disparado a Florencia; la policía detiene la discusión. Victoria descubre a Felipe y a Clementina registrando la carta que Sergio escribió para ella, lo que la enardece; Felipe convence a Victoria de confiar en que él la ayudará a encontrar la justicia gracias a la confesión de Sergio: Fernanda Alcoy está detrás de los diversos asesinatos. Una vez en el hospital, Florencia revela todos sus secretos ante Nicolás: la mujer que le disparó fue Fernanda del Casal para evitar que la acusara con la policía por la muerte de Genara y Sergio; Florencia además asume su responsabilidad de haber provocado a Victoria para tener una riña con ella y hacer creer que fue por su culpa que perdió a su hijo, pero Victoria se contuvo; Nicolás está sorprendido. El último secreto que revela Florencia es que el verdadero asesino de Jaimito del Casal es Rosendo Zapata." type="episode" contentRating="NONADULT" duration="3044000" grandparentArt="https://cdn-images.watch4.com/1080/1/1766822-thumb.jpg" grandparentGuid="plex://show/67e89124191c82b2c18c3e63" grandparentKey="/library/metadata/67e89124191c82b2c18c3e63" grandparentRatingKey="67e89124191c82b2c18c3e63" grandparentThumb="https://cdn-images.watch4.com/1920/2/1766822-portrait.jpg" grandparentTitle="353" grandparentType="show" index="128" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://cdn-images.watch4.com/1080/1/1766822-thumb.jpg" title="La Trepadora - S01:E128" userState="0"><Image alt="La Trepadora - S01:E128" type="coverArt" url="https://cdn-images.watch4.com/1080/1/1766822-thumb.jpg"/><Image alt="La Trepadora - S01:E128" type="coverPoster" url="https://cdn-images.watch4.com/1920/2/1766822-portrait.jpg"/><Image alt="La Trepadora - S01:E128" type="snapshot" url="https://cdn-images.watch4.com/1080/1/1766822-thumb.jpg"/><Genre filter="genre=6a0c2728768cf9b31f6fe02a" id="6a0c2728768cf9b31f6fe02a" key="/library/sections/home/all?genre=6a0c2728768cf9b31f6fe02a" ratingKey="genre_6a0c2728768cf9b31f6fe02a" slug="bingeworthy" tag="Bingeworthy" type="directory" context="tag.genre"/><Media beginsAt="1783085036" duration="3044000" endsAt="1783088080" id="6a3e7173e2c04503f66caa91" onAir="0" premiere="0" videoResolution="720" origin="livetv"/><Media beginsAt="1783115072" duration="3045000" endsAt="1783118117" id="6a3e7173e2c04503f66caa9b" onAir="0" premiere="0" videoResolution="720" origin="livetv"/></Video></MediaContainer>
