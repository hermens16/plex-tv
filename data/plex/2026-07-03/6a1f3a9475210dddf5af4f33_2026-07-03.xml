3f98578b9238e1cdb8a" id="620143f98578b9238e1cdb8a" key="/library/sections/home/all?genre=620143f98578b9238e1cdb8a" ratingKey="genre_620143f98578b9238e1cdb8a" slug="sports" tag="Sports" type="directory" context="tag.genre"/><Media beginsAt="1783037384" duration="4909000" endsAt="1783042293" id="6a35393a14881831bcccb564" onAir="0" premiere="0" videoResolution="720" origin="livetv"/><Media beginsAt="1783119514" duration="4909000" endsAt="1783124423" id="6a35393a14881831bcccb577" onAir="0" premiere="0" videoResolution="720" origin="livetv"/></Video><Video guid="plex://episode/6a2ff390a07b9cdd336fc5d4" key="/library/metadata/6a2ff390a07b9cdd336fc5d4" ratingKey="6a2ff390a07b9cdd336fc5d4" summary="O episódio de estreia leva o espectador rumo às origens do Jiu Jitsu. No Japão, conhecemos as técnicas dos samurais aperfeiçoadas por Mitsuyo Maeda, o Conde Koma. Já no coração da Floresta Amazônica brasileira, somos introduzidos à família Gracie, responsável pela criação do Jiu Jitsu brasileiro e por sua expansão ao redor do mundo. Através de entrevistas, imagens oníricas captadas nos dois países e de raro material de arquivo, o espectador é apresentado ao universo da arte suave." type="episode" contentRating="A12" duration="1919000" grandparentArt="https://images.frequency.com/video/7457087087958308959/solid/rectangle/w1920_h1080/utuhjfkzm60o1tv89977mujhz.jpg" grandparentGuid="plex://show/6a2ff384a07b9cdd336fc56c" grandparentKey="/library/metadata/6a2ff384a07b9cdd336fc56c" grandparentRatingKey="6a2ff384a07b9cdd336fc56c" grandparentThumb="https://images.frequency.com/video/originals/7457087087958308959/Texted/rectangle/m2bfxvz0tolx17kmyrl1js39c.png" grandparentTitle="NA ESTRADA DO JIU-JITSU - T1 E1" grandparentType="show" hasGenericTitle="1" index="1" originallyAvailableAt="2026-05-04T15:29:43Z" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://images.frequency.com/video/7457087087958308959/solid/rectangle/w1920_h1080/utuhjfkzm60o1tv89977mujhz.jpg" title="Episode 1" userState="0" year="2026"><Image alt="Episode 1" type="coverArt" url="https://images.frequency.com/video/7457087087958308959/solid/rectangle/w1920_h1080/utuhjfkzm60o1tv89977mujhz.jpg"/><Image alt="Episode 1" type="coverPoster" url="https://images.frequency.com/video/originals/7457087087958308959/Texted/rectangle/m2bfxvz0tolx17kmyrl1js39c.png"/><Image alt="Episode 1" type="snapshot" url="https://images.frequency.com/video/7457087087958308959/solid/rectangle/w1920_h1080/utuhjfkzm60o1tv89977mujhz.jpg"/><Genre filter="genre=620143f98578b9238e1cdb8a" id="620143f98578b9238e1cdb8a" key="/library/sections/home/all?genre=620143f98578b9238e1cdb8a" ratingKey="genre_620143f98578b9238e1cdb8a" slug="sports" tag="Sports" type="directory" context="tag.genre"/><Media beginsAt="1783046689" duration="1919000" endsAt="1783048608" id="6a35393a14881831bcccb567" onAir="0" premiere="0" videoResolution="720" origin="livetv"/></Video><Video guid="plex://episode/6a2ff390a07b9cdd336fc5d6" key="/library/metadata/6a2ff390a07b9cdd336fc5d6" ratingKey="6a2ff390a07b9cdd336fc5d6" summary="No segundo episódio de “Jiu-Jitsu na Estrada”, vamos seguir contando a história da arte suave. No coração da mítica Belém do Pará, vamos refazer os passos de Conde Koma, chegando até sua primeira residência oficial, visitando o local onde foi sepultado e conversando com atletas sobre a influência do mestre que dura até os dias de hoje. É na cidade também que vamos conhecer atletas e treinadores como Dedé e Márcio Pontes que nos presentam o verdadeiro celeiro de talentos do Jiu Jitsu que é a Região Norte do Brasil. Pegando a estrada rumo a Copacabana, no Rio de Janeiro, conversamos com um dos herdeiros mais importantes da dinastia Gracie, o mestre Robson. Não muito longe dali, na Comunidade do Pereirão, vamos conhecer a história de luta e superação de Cleiton de Jesus, que, atualmente, realiza um belo trabalho de ensino de Jiu Jitsu para as crianças da favela." type="episode" contentRating="A12" duration="1931000" grandparentArt="https://images.frequency.com/video/7457084067216838296/solid/rectangle/w1920_h1080/hlw3gicom6qb1as9njqe9sho0.jpg" grandparentGuid="plex://show/6a2ff384a07b9cdd336fc56d" grandparentKey="/library/metadata/6a2ff384a07b9cdd336fc56d" grandparentRatingKey="6a2ff384a07b9cdd336fc56d" grandparentThumb="https://images.frequency.com/video/originals/7457084067216838296/Texted/rectangle/5ddrzxwr21lg17abwnutshsxs.png" grandparentTitle="NA ESTRADA DO JIU-JITSU - T1 E2" grandparentType="show" hasGenericTitle="1" index="1" originallyAvailableAt="2026-05-04T15:21:43Z" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://images.frequency.com/video/7457084067216838296/solid/rectangle/w1920_h1080/hlw3gicom6qb1as9njqe9sho0.jpg" title="Episode 1" userState="0" year="2026"><Image alt="Episode 1" type="coverArt" url="https://images.frequency.com/video/7457084067216838296/solid/rectangle/w1920_h1080/hlw3gicom6qb1as9njqe9sho0.jpg"/><Image alt="Episode 1" type="coverPoster" url="https://images.frequency.com/video/originals/7457084067216838296/Texted/rectangle/5ddrzxwr21lg17abwnutshsxs.png"/><Image alt="Episode 1" type="snapshot" url="https://images.frequency.com/video/7457084067216838296/solid/rectangle/w1920_h1080/hlw3gicom6qb1as9njqe9sho0.jpg"/><Genre filter="genre=620143f98578b9238e1cdb8a" id="620143f98578b9238e1cdb8a" key="/library/sections/home/all?genre=620143f98578b9238e1cdb8a" ratingKey="genre_620143f98578b9238e1cdb8a" slug="sports" tag="Sports" type="directory" context="tag.genre"/><Media beginsAt="1783048608" duration="1931000" endsAt="1783050539" id="6a35393a14881831bcccb568" onAir="0" premiere="0" videoResolution="720" origin="livetv"/></Video><Video guid="plex://episode/6a2ff390a07b9cdd336fc5d8" key="/library/metadata/6a2ff390a07b9cdd336fc5d8" ratingKey="6a2ff390a07b9cdd336fc5d8" summary="O episódio de hoje de Jiu Jitsu na Estrada está focado na propagação do Jiu Jitsu brasileiro no Balneário de São Sebastião do Rio de Janeiro. As dificuldades de se forjar um novo esporte, a chegada da família Gracie à cidade maravilhosa. A habilidade dos irmãos Carlos e Hélio passada de geração em geração pelos Gracie. Os grandes discípulos formados pelo clã que se sagraram verdadeiros campeões nos tatames do Brasil e do mundo. O legado deixado pela família Gracie e perpetuado por seus pupilos - que aprenderam os golpes ensinados por seus mestres - e atualmente são grandes nomes do universo da arte suave. O programa de hoje está histórico!" type="episode" contentRating="A12" duration="1882000" grandparentArt="https://images.frequency.com/video/7457057344502162244/solid/rectangle/w1920_h1080/pksy6t8ioltp1ghbqazpsxb0w.jpg" grandparentGuid="plex://show/6a2ff384a07b9cdd336fc56e" grandparentKey="/library/metadata/6a2ff384a07b9cdd336fc56e" grandparentRatingKey="6a2ff384a07b9cdd336fc56e" grandparentThumb="https://images.frequency.com/video/originals/7457057344502162244/Texted/rectangle/1ptm57b4sbcos17wvv19q7j3lc.png" grandparentTitle="NA ESTRADA DO JIU-JITSU - T1 E3" grandparentType="show" hasGenericTitle="1" index="1" originallyAvailableAt="2026-05-04T13:39:33Z" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://images.frequency.com/video/7457057344502162244/solid/rectangle/w1920_h1080/pksy6t8ioltp1ghbqazpsxb0w.jpg" title="Episode 1" userState="0" year="2026"><Image alt="Episode 1" type="coverArt" url="https://images.frequency.com/video/7457057344502162244/solid/rectangle/w1920_h1080/pksy6t8ioltp1ghbqazpsxb0w.jpg"/><Image alt="Episode 1" type="coverPoster" url="https://images.frequency.com/video/originals/7457057344502162244/Texted/rectangle/1ptm57b4sbcos17wvv19q7j3lc.png"/><Image alt="Episode 1" type="snapshot" url="https://images.frequency.com/video/7457057344502162244/solid/rectangle/w1920_h1080/pksy6t8ioltp1ghbqazpsxb0w.jpg"/><Genre filter="genre=620143f98578b9238e1cdb8a" id="620143f98578b9238e1cdb8a" key="/library/sections/home/all?genre=620143f98578b9238e1cdb8a" ratingKey="genre_620143f98578b9238e1cdb8a" slug="sports" tag="Sports" type="directory" context="tag.genre"/><Media beginsAt="1783050539" duration="1882000" endsAt="1783052421" id="6a35393a14881831bcccb569" onAir="0" premiere="0" videoResolution="720" origin="livetv"/></Video><Video guid="plex://episode/6a2ff390a07b9cdd336fc5dc" key="/library/metadata/6a2ff390a07b9cdd336fc5dc" ratingKey="6a2ff390a07b9cdd336fc5dc" summary="Uma nova luta passa a existir. Criada no Japão, mas adaptada em solo brasileiro pelos irmãos Gracie, o Jiu Jitsu agora precisa ser conhecido. Como ensinar uma luta que ninguém sabe exatamente qual é? Como diferenciar a arte suave do karatê, do boxe tailandês, da capoeira e do judô? A resposta encontrada pelos precursores do Jiu Jitsu foi o desafio. Os mestres e seus pupilos desafiavam toda a sorte de lutadores de outras modalidades, criando assim as famosas “tretas” e rivalidades históricas. Com técnicas simples e inesperadas que levavam seus oponente ao chão, os alunos da família Gracie venciam todos os desafios propostos, demonstrando a superioridade do Jiu Jitsu brasileiro. Pouco a pouco, o Jiu Jitsu vai conquistando corações e mentes ao redor do Brasil até consagrar-se como um dos esportes mais queridos do país." type="episode" contentRating="A12" duration="1934000" grandparentArt="https://images.frequency.com/video/7457081283049698957/solid/rectangle/w1920_h1080/8eqhkfs81wr31e375r808hnvs.jpg" grandparentGuid="plex://show/6a2ff384a07b9cdd336fc570" grandparentKey="/library/metadata/6a2ff384a07b9cdd336fc570" grandparentRatingKey="6a2ff384a07b9cdd336fc570" grandparentThumb="https://images.frequency.com/video/originals/7457081283049698957/Texted/rectangle/3zb1l62n6x1b1cgz35xbj6h4c.png" grandparentTitle="NA ESTRADA DO JIU JITSU - T1 E4" grandparentType="show" hasGenericTitle="1" index="1" originallyAvailableAt="2026-05-04T15:17:42Z" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://images.frequency.com/video/7457081283049698957/solid/rectangle/w1920_h1080/8eqhkfs81wr31e375r808hnvs.jpg" title="Episode 1" userState="0" year="2026"><Image alt="Episode 1" type="coverArt" url="https://images.frequency.com/video/7457081283049698957/solid/rectangle/w1920_h1080/8eqhkfs81wr31e375r808hnvs.jpg"/><Image alt="Episode 1" type="coverPoster" url="https://images.frequency.com/video/originals/7457081283049698957/Texted/rectangle/3zb1l62n6x1b1cgz35xbj6h4c.png"/><Image alt="Episode 1" type="snapshot" url="https://images.frequency.com/video/7457081283049698957/solid/rectangle/w1920_h1080/8eqhkfs81wr31e375r808hnvs.jpg"/><Genre filter="genre=620143f98578b9238e1cdb8a" id="620143f98578b9238e1cdb8a" key="/library/sections/home/all?genre=620143f98578b9238e1cdb8a" ratingKey="genre_620143f98578b9238e1cdb8a" slug="sports" tag="Sports" type="directory" context="tag.genre"/><Media beginsAt="1783061925" duration="1934000" endsAt="1783063859" id="6a35393a14881831bcccb56b" onAir="0" premiere="0" videoResolution="720" origin="livetv"/></Video><Video guid="plex://episode/6a2ff390a07b9cdd336fc5de" key="/library/metadata/6a2ff390a07b9cdd336fc5de" ratingKey="6a2ff390a07b9cdd336fc5de" summary="Através deste episódio vamos conhecer como o Jiu Jitsu brasileiro foi conquistando território nos Estados Unidos. Rorion Gracie, responsável por esta expansão, vai contar em detalhes seus primeiros anos nos EUA, as dificuldades do início, os desafios de luta de garagem que vieram a ser os precursores de uma competição que tempos depois viria mobilizar milhões de dólares, golpes, espectadores e sangue o UFC. Já no subúrbio do Rio de Janeiro, vamos conversar com mestre Fadda, discípulo pouco conhecido de Matsuo Maeda, o Conde Koma. Na contramão da fama dos Gracie, Fadda leva uma vida de ensinamentos e luta bem longe dos holofotes." type="episode" contentRating="A12" duration="1900000" grandparentArt="https://images.frequency.com/video/7457051317984511707/solid/rectangle/w1920_h1080/10u1txv6uccur1mx6g2buyeax1.jpg" grandparentGuid="plex://show/6a2ff384a07b9cdd336fc571" grandparentKey="/library/metadata/6a2ff384a07b9cdd336fc571" grandparentRatingKey="6a2ff384a07b9cdd336fc571" grandparentThumb="https://images.frequency.com/video/originals/7457051317984511707/Texted/rectangle/tny17qr8xqsu1rcli4brt2tc9.png" grandparentTitle="NA ESTRADA DO JIU-JITSU - T1 E5" grandparentType="show" hasGenericTitle="1" index="1" originallyAvailableAt="2026-05-04T13:17:31Z" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://images.frequency.com/video/7457051317984511707/solid/rectangle/w1920_h1080/10u1txv6uccur1mx6g2buyeax1.jpg" title="Episode 1" userState="0" year="2026"><Image alt="Episode 1" type="coverArt" url="https://images.frequency.com/video/7457051317984511707/solid/rectangle/w1920_h1080/10u1txv6uccur1mx6g2buyeax1.jpg"/><Image alt="Episode 1" type="coverPoster" url="https://images.frequency.com/video/originals/7457051317984511707/Texted/rectangle/tny17qr8xqsu1rcli4brt2tc9.png"/><Image alt="Episode 1" type="snapshot" url="https://images.frequency.com/video/7457051317984511707/solid/rectangle/w1920_h1080/10u1txv6uccur1mx6g2buyeax1.jpg"/><Genre filter="genre=620143f98578b9238e1cdb8a" id="620143f98578b9238e1cdb8a" key="/library/sections/home/all?genre=620143f98578b9238e1cdb8a" ratingKey="genre_620143f98578b9238e1cdb8a" slug="sports" tag="Sports" type="directory" context="tag.genre"/><Media beginsAt="1783063859" duration="1900000" endsAt="1783065759" id="6a35393a14881831bcccb56c" onAir="0" premiere="0" videoResolution="720" origin="livetv"/></Video><Video guid="plex://episode/6a2ff391a07b9cdd336fc5e0" key="/library/metadata/6a2ff391a07b9cdd336fc5e0" ratingKey="6a2ff391a07b9cdd336fc5e0" summary="Após ser conhecido e legitimado por atletas de diferentes modalidades, o Jiu Jitsu precisava de grana! Os pioneiros do esporte nos EUA precisaram buscar patrocínios que pudessem viabilizar os combates, pagar os lutadores e as competições. É assim que surgem os primeiros investidores, os primeiros negócios, as primeiras perdas e os primeiros lucros. Longe de ser um esporte mercenário, vamos conhecer também o encontro da arte suave com a yoga, através do atleta Saulo Ribeiro, que, apesar de viver nos Estados Unidos, é mais um legítimo representante do Jiu Jitsu manauara e do espírito de luta contido no DNA caboclo.  Oss! Opa, quer dizer… Namastê!" type="episode" contentRating="A12" duration="1925000" grandparentArt="https://images.frequency.com/video/7457074485266106209/solid/rectangle/w1920_h1080/1v0l4q2b6si4a1vygnpfnf7n9k.jpg" grandparentGuid="plex://show/6a2ff384a07b9cdd336fc572" grandparentKey="/library/metadata/6a2ff384a07b9cdd336fc572" grandparentRatingKey="6a2ff384a07b9cdd336fc572" grandparentThumb="https://images.frequency.com/video/originals/7457074485266106209/Texted/rectangle/q5d4gwiw9wun1rx3s8f9vsz0y.png" grandparentTitle="NA ESTRADA DO JIU-JITSU - T1 E6" grandparentType="show" hasGenericTitle="1" index="1" originallyAvailableAt="2026-05-04T14:43:40Z" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://images.frequency.com/video/7457074485266106209/solid/rectangle/w1920_h1080/1v0l4q2b6si4a1vygnpfnf7n9k.jpg" title="Episode 1" userState="0" year="2026"><Image alt="Episode 1" type="coverArt" url="https://images.frequency.com/video/7457074485266106209/solid/rectangle/w1920_h1080/1v0l4q2b6si4a1vygnpfnf7n9k.jpg"/><Image alt="Episode 1" type="coverPoster" url="https://images.frequency.com/video/originals/7457074485266106209/Texted/rectangle/q5d4gwiw9wun1rx3s8f9vsz0y.png"/><Image alt="Episode 1" type="snapshot" url="https://images.frequency.com/video/7457074485266106209/solid/rectangle/w1920_h1080/1v0l4q2b6si4a1vygnpfnf7n9k.jpg"/><Genre filter="genre=620143f98578b9238e1cdb8a" id="620143f98578b9238e1cdb8a" key="/library/sections/home/all?genre=620143f98578b9238e1cdb8a" ratingKey="genre_620143f98578b9238e1cdb8a" slug="sports" tag="Sports" type="directory" context="tag.genre"/><Media beginsAt="1783065759" duration="1925000" endsAt="1783067684" id="6a35393a14881831bcccb56d" onAir="0" premiere="0" videoResolution="720" origin="livetv"/></Video><Video guid="plex://episode/6a2ff391a07b9cdd336fc5e2" key="/library/metadata/6a2ff391a07b9cdd336fc5e2" ratingKey="6a2ff391a07b9cdd336fc5e2" summary="Conquistando cada vez mais adeptos e admiradores, o Jiu Jitsu segue seu caminho natural de evolução através de expoentes como André Galvão. Dono de um estilo de luta que prioriza o confronto ao invés da amarração, Galvão está no auge de sua carreira, colecionando títulos por onde passa. Ao longo do episódio vamos refletir junto com os entrevistados sobre a seguinte questão: afinal, o Jiu Jitsu é um esporte ou uma técnica de defesa pessoal?" type="episode" contentRating="A12" duration="1879000" grandparentArt="https://images.frequency.com/video/7457058643014465716/solid/rectangle/w1920_h1080/1o77bavkx4l7e1r8za2004rtnz.jpg" grandparentGuid="plex://show/6a2ff384a07b9cdd336fc573" grandparentKey="/library/metadata/6a2ff384a07b9cdd336fc573" grandparentRatingKey="6a2ff384a07b9cdd336fc573" grandparentThumb="https://images.frequency.com/video/originals/7457058643014465716/Texted/rectangle/mz72dj5dn5wu1wvf4kpxkkv76.png" grandparentTitle="NA ESTRADA DO JIU-JITSU - T1 E7" grandparentType="show" hasGenericTitle="1" index="1" originallyAvailableAt="2026-05-04T13:55:34Z" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://images.frequency.com/video/7457058643014465716/solid/rectangle/w1920_h1080/1o77bavkx4l7e1r8za2004rtnz.jpg" title="Episode 1" userState="0" year="2026"><Image alt="Episode 1" type="coverArt" url="https://images.frequency.com/video/7457058643014465716/solid/rectangle/w1920_h1080/1o77bavkx4l7e1r8za2004rtnz.jpg"/><Image alt="Episode 1" type="coverPoster" url="https://images.frequency.com/video/originals/7457058643014465716/Texted/rectangle/mz72dj5dn5wu1wvf4kpxkkv76.png"/><Image alt="Episode 1" type="snapshot" url="https://images.frequency.com/video/7457058643014465716/solid/rectangle/w1920_h1080/1o77bavkx4l7e1r8za2004rtnz.jpg"/><Genre filter="genre=620143f98578b9238e1cdb8a" id="620143f985