umb="https://cdn-images.watch4.com/1080/3/1672730.jpg" title="S01:E79" userState="0"><Image alt="S01:E79" type="coverArt" url="https://cdn-images.watch4.com/1080/3/1672730.jpg"/><Image alt="S01:E79" type="coverPoster" url="https://cdn-images.watch4.com/1920/2/1672730.jpg"/><Image alt="S01:E79" type="snapshot" url="https://cdn-images.watch4.com/1080/3/1672730.jpg"/><Genre filter="genre=6a0c2728768cf9b31f6fe02a" id="6a0c2728768cf9b31f6fe02a" key="/library/sections/home/all?genre=6a0c2728768cf9b31f6fe02a" ratingKey="genre_6a0c2728768cf9b31f6fe02a" slug="bingeworthy" tag="Bingeworthy" type="directory" context="tag.genre"/><Media beginsAt="1780480757" duration="3091000" endsAt="1780483848" id="6a16e42ec05d5b5429abbe6c" onAir="0" premiere="0" videoResolution="720" origin="livetv"/><Media beginsAt="1780510511" duration="3090000" endsAt="1780513601" id="6a16e42ec05d5b5429abbe76" onAir="0" premiere="0" videoResolution="720" origin="livetv"/></Video><Video guid="plex://episode/6a16e42dc05d5b5429abbe5e" key="/library/metadata/6a16e42dc05d5b5429abbe5e" ratingKey="6a16e42dc05d5b5429abbe5e" summary="Adelaida de Guanipa pide a su hija Victoria la deje a solas con su esposo, a quien reta a decidir si va a dejar que su deseo de vengarse de Carlos Hansen termine de enfrentarlo con su hija para darle a la muchacha más motivos para odiarlo; Hilario ordena a su capataz Moncho se encargue de que el empresario regrese a la capital de inmediato. Segura de que hace lo correcto, Fernanda de Alcoy se presenta en casa de Marisa a ofrecerle dinero a cambio de que se vaya lejos de la hacienda y se olvide para siempre de su esposo Leopoldo, quien, según ella, no desea verla nunca más; la humilde mujer, muy digna, rechaza el chantaje de la señora. Entrada la noche; Victoria acusa sorpresa cuando Nicolás Del Casal se presenta en su casa buscando a Adelaida para darle un mensaje de su tía Fernanda; cuando logra verla a solas, Nicolás revela a la señora Guanipa que el encargo no es de su tía sino de Carlos Hansen, quien le envió una carta por medio suyo; Adelaida agradece al joven su discreción al respecto. Florencia cree que la apuesta de Victoria con Nicolás es para demostrarle que es superior que él; Fernanda, por el contrario, considera que todo lo que hace la joven Guanipa es para seguir viendo a su amado; la señora Alcoy propone a su sobrina política buscar la manera de deshacerse de Victoria para siempre." type="episode" contentRating="NONADULT" duration="3055000" grandparentArt="https://cdn-images.watch4.com/1080/3/1766385.jpg" grandparentGuid="plex://show/67a0b759cb3d68c83b1e7d4f" grandparentKey="/library/metadata/67a0b759cb3d68c83b1e7d4f" grandparentRatingKey="67a0b759cb3d68c83b1e7d4f" grandparentThumb="https://cdn-images.watch4.com/1920/2/1766385.jpg" grandparentTitle="La Trepadora" grandparentType="show" index="97" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://cdn-images.watch4.com/1080/3/1766385.jpg" title="S01:E097" userState="0"><Image alt="S01:E097" type="coverArt" url="https://cdn-images.watch4.com/1080/3/1766385.jpg"/><Image alt="S01:E097" type="coverPoster" url="https://cdn-images.watch4.com/1920/2/1766385.jpg"/><Image alt="S01:E097" type="snapshot" url="https://cdn-images.watch4.com/1080/3/1766385.jpg"/><Genre filter="genre=6a0c2728768cf9b31f6fe02a" id="6a0c2728768cf9b31f6fe02a" key="/library/sections/home/all?genre=6a0c2728768cf9b31f6fe02a" ratingKey="genre_6a0c2728768cf9b31f6fe02a" slug="bingeworthy" tag="Bingeworthy" type="directory" context="tag.genre"/><Media beginsAt="1780493008" duration="3055000" endsAt="1780496063" id="6a16e42ec05d5b5429abbe70" onAir="0" premiere="0" videoResolution="720" origin="livetv"/><Media beginsAt="1780522895" duration="3056000" endsAt="1780525951" id="6a16e42ec05d5b5429abbe7a" onAir="0" premiere="0" videoResolution="720" origin="livetv"/></Video><Video guid="plex://episode/6a16e42ec05d5b5429abbe5f" key="/library/metadata/6a16e42ec05d5b5429abbe5f" ratingKey="6a16e42ec05d5b5429abbe5f" summary="Al abrir una gaveta, Malena encuentra un portarretratos con el cristal roto, con una vieja foto de ella e Isabel. Alfonso llega y la descubre, pero Malena reacciona con mucha molestia hacia él – Norma está a punto de salir de la habitación, con el arma escondida dentro de una cesta de ropa sucia, cuando es sorprendida por la llegada de Gertrudis." type="episode" contentRating="NONADULT" duration="3182000" grandparentArt="https://cdn-images.watch4.com/1080/3/1673084.jpg" grandparentGuid="plex://show/68bad9a39aa661c3574d4960" grandparentKey="/library/metadata/68bad9a39aa661c3574d4960" grandparentRatingKey="68bad9a39aa661c3574d4960" grandparentThumb="https://cdn-images.watch4.com/1920/2/1673084.jpg" grandparentTitle="Corazon Traicionado" grandparentType="show" index="115" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://cdn-images.watch4.com/1080/3/1673084.jpg" title="Corazón Traicionado - S01:E115" userState="0"><Image alt="Corazón Traicionado - S01:E115" type="coverArt" url="https://cdn-images.watch4.com/1080/3/1673084.jpg"/><Image alt="Corazón Traicionado - S01:E115" type="coverPoster" url="https://cdn-images.watch4.com/1920/2/1673084.jpg"/><Image alt="Corazón Traicionado - S01:E115" type="snapshot" url="https://cdn-images.watch4.com/1080/3/1673084.jpg"/><Genre filter="genre=6a0c2728768cf9b31f6fe02a" id="6a0c2728768cf9b31f6fe02a" key="/library/sections/home/all?genre=6a0c2728768cf9b31f6fe02a" ratingKey="genre_6a0c2728768cf9b31f6fe02a" slug="bingeworthy" tag="Bingeworthy" type="directory" context="tag.genre"/><Media beginsAt="1780469678" duration="3182000" endsAt="1780472860" id="6a16e42ec05d5b5429abbe68" onAir="0" premiere="0" videoResolution="720" origin="livetv"/><Media beginsAt="1780499201" duration="3182000" endsAt="1780502383" id="6a16e42ec05d5b5429abbe72" onAir="0" premiere="0" videoResolution="720" origin="livetv"/><Media beginsAt="1780529222" duration="3182000" endsAt="1780532404" id="6a16e42ec05d5b5429abbe7c" onAir="0" premiere="0" vide