<MediaContainer offset="0" totalSize="13" identifier="tv.plex.provider.epg" size="13"><Video guid="plex://episode/6a275eedd380ac48b07574ee" key="/library/metadata/6a275eedd380ac48b07574ee" ratingKey="6a275eedd380ac48b07574ee" summary="Camila y su madre, en un emotivo encuentro, se unen en un abrazo anhelado durante tantos años. Muchas preguntas para Rosa quien se justifica diciéndole que su intención fue siempre protegerla y evitar que se contaminara con odio y rencor como siente ella. Marcelina ronda por un parque aturdida, desequilibrada y nerviosa, luego de conocerse su traición." type="episode" contentRating="NONADULT" duration="3025000" grandparentArt="https://cdn-images.watch4.com/1080/3/1672724.jpg" grandparentGuid="plex://show/66ea19708651b52ba9cee047" grandparentKey="/library/metadata/66ea19708651b52ba9cee047" grandparentRatingKey="66ea19708651b52ba9cee047" grandparentThumb="https://cdn-images.watch4.com/1920/2/1672724.jpg" grandparentTitle="Piel Salvaje" grandparentType="show" index="110" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://cdn-images.watch4.com/1080/3/1672724.jpg" title="S01:E110" userState="0"><Image alt="S01:E110" type="coverArt" url="https://cdn-images.watch4.com/1080/3/1672724.jpg"/><Image alt="S01:E110" type="coverPoster" url="https://cdn-images.watch4.com/1920/2/1672724.jpg"/><Image alt="S01:E110" type="snapshot" url="https://cdn-images.watch4.com/1080/3/1672724.jpg"/><Genre filter="genre=6a0c2728768cf9b31f6fe02a" id="6a0c2728768cf9b31f6fe02a" key="/library/sections/home/all?genre=6a0c2728768cf9b31f6fe02a" ratingKey="genre_6a0c2728768cf9b31f6fe02a" slug="bingeworthy" tag="Bingeworthy" type="directory" context="tag.genre"/><Media beginsAt="1781751076" duration="3159000" endsAt="1781754235" id="6a2a01fe6388f19dcdad6cf4" onAir="0" premiere="0" videoResolution="720" origin="livetv"/></Video><Video guid="plex://episode/6a2807adbde8823f225a4fb0" key="/library/metadata/6a2807adbde8823f225a4fb0" ratingKey="6a2807adbde8823f225a4