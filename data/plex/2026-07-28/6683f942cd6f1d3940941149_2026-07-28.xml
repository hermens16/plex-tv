<MediaContainer offset="0" totalSize="8" identifier="tv.plex.provider.epg" size="8"><Video art="https://img.static-ottera.com/prod/run/video/thumbnails/widescreen/3840x2160/robert_the_bruce_thumbnail_16x9_widescreen_bpor.jpg" guid="plex://movie/6a55829a3d414a144a6eab36" key="/library/metadata/6a55829a3d414a144a6eab36" ratingKey="6a55829a3d414a144a6eab36" summary="Após ajudar William Wallace na luta pela liberdade retratada em &quot;Coração Valente&quot;, Robert the Bruce é coroado rei da Escócia livre. Mas os ingleses estavam determinados a recuperar seu território perdido. Batalha após batalha, Robert é derrotado, e a nobreza escocesa lhe dá as costas. Do nada, e tendo a liberdade como única motivação, ele ressurge mais uma vez para lutar pelo seu país." type="movie" contentRating="M/16" duration="8629000" originallyAvailableAt="2025-09-20T00:00:00Z" requiresConsent="1" skipParent="1" thumb="https://img.static-ottera.com/prod/run/video/thumbnails/poster/2000x2858/robert_the_bruce_thumbnail_7x10_poster_bpor.jpg" title="O Rei Da Escócia" userState="0" year="2025"><Image alt="O Rei Da Escócia" type="coverArt" url="https://img.static-ottera.com/prod/run/video/thumbnails/widescreen/3840x2160/robert_the_bruce_thumbnail_16x9_widescreen_bpor.jpg"/><Image alt="O Rei Da Escócia" type="coverPoster" url="https://img.static-ottera.com/prod/run/video/thumbnails/poster/2000x2858/robert_the_bruce_thumbnail_7x10_poster_bpor.jpg"/><Genre filter="genre=6a0c2728768cf9b31f6fe030" id="6a0c2728768cf9b31f6fe030" key="/library/sections/home/all?genre=6a0c2728768cf9b31f6fe030" ratingKey="genre_6a0c2728768cf9b31f6fe030" slug="adrenaline-sci-fi" tag="Adrenaline + Sci-Fi" type="directory" context="tag.genre"/><Media beginsAt="1785198971" duration="8629000" endsAt="1785207600" id="6a600e931bede9c272e946d6" live="0" onAir="0" premiere="0" videoResolution="720" origin="livetv"/></Video><Video art="https://img.static-ottera.com/prod/run/video/thumbnails/widescreen/3840x2160/seal_team_six_thumbnail