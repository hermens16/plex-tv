show/69d79cef6ad16397528a860a" grandparentKey="/library/metadata/69d79cef6ad16397528a860a" grandparentRatingKey="69d79cef6ad16397528a860a" grandparentThumb="https://cdn-images.watch4.com/1920/2/1672731.jpg" grandparentTitle="El Desprecio" grandparentType="show" index="57" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://cdn-images.watch4.com/1080/3/1672731.jpg" title="S01:E57" userState="0"><Image alt="S01:E57" type="coverArt" url="https://cdn-images.watch4.com/1080/3/1672731.jpg"/><Image alt="S01:E57" type="coverPoster" url="https://cdn-images.watch4.com/1920/2/1672731.jpg"/><Image alt="S01:E57" type="snapshot" url="https://cdn-images.watch4.com/1080/3/1672731.jpg"/><Genre filter="genre=6a0c2728768cf9b31f6fe02a" id="6a0c2728768cf9b31f6fe02a" key="/library/sections/home/all?genre=6a0c2728768cf9b31f6fe02a" ratingKey="genre_6a0c2728768cf9b31f6fe02a" slug="bingeworthy" tag="Bingeworthy" type="directory" context="tag.genre"/><Media beginsAt="1781166507" duration="2267000" endsAt="1781168774" id="6a2218f07845c0e000edc5b7" onAir="0" premiere="0" videoResolution="720" origin="livetv"/><Media beginsAt="1781196234" duration="2602000" endsAt="1781198836" id="6a2218f07845c0e000edc5c1" onAir="0" premiere="0" videoResolution="720" origin="livetv"/></Video><Video guid="plex://episode/6a2218ef7845c0e000edc5b1" key="/library/metadata/6a2218ef7845c0e000edc5b1" ratingKey="6a2218ef7845c0e000edc5b1" summary="Comprometida a olvidar a Nicolás Del Casal, Victoria decide corresponder al amor que Sergio le ofrece, aunque Sergio cree que la joven Guanipa no está preparada aún para volver a enamorarse. Florencia quiere asegurarse de que Nicolás no haya creído en Victoria cuando ésta afirmó haber sido una víctima del difunto Rosendo Zapata, quien en vida quisiera abusar de ella. La tristeza embarga a Hilario mientras recorre los rincones de la hacienda Cantarrana donde recuerda haber sido un hombre al que todos respetaban y del que ahora sólo quedan despojos. Caída la noche, Fernanda se apoya en Leopoldo para imponerle un castigo a su hija Eugenia por haberle mentido; Eugenia trata de manipular a su padre, pues le suplica dejarla salir, pero obligan a la joven Alcoy a quedarse en casa. Nicolás es abordado por su esposa, quien desea asistir a un evento que Nicolás se niega a ir, pero cambia de opinión repentinamente al saber que el evento no es otro que la misma subasta de arte a la que Sergio invitó a Victoria." type="episode" contentRating="NONADULT" duration="3070000" grandparentArt="https://cdn-images.watch4.com/1080/3/1766385.jpg" grandparentGuid="plex://show/67a0b759cb3d68c83b1e7d4f" grandparentKey="/library/metadata/67a0b759cb3d68c83b1e7d4f" grandparentRatingKey="67a0b759cb3d68c83b1e7d4f" grandparentThumb="https://cdn-images.watch4.com/1920/2/1766385.jpg" grandparentTitle="La Trepadora" grandparentType="show" index="104" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://cdn-images.watch4.com/1080/3/1766385.jpg" title="S01:E104" userState="0"><Image alt="S01:E104" type="coverArt" url="https://cdn-images.watch4.com/1080/3/1766385.jpg"/><Image alt="S01:E104" type="coverPoster" url="https://cdn-images.watch4.com/1920/2/1766385.jpg"/><Image alt="S01:E104" type="snapshot" url="https://cdn-images.watch4.com/1080/3/1766385.jpg"/><Genre filter="genre=6a0c2728768cf9b31f6fe02a" id="6a0c2728768cf9b31f6fe02a" key="/library/sections/home/all?genre=6a0c2728768cf9b31f6fe02a" ratingKey="genre_6a0c2728768cf9b31f6fe02a" slug="bingeworthy" tag="Bingeworthy" type="directory" context="tag.genre"/><Media beginsAt="1781184398" duration="3070000" endsAt="1781187468" id="6a2218f07845c0e000edc5bd" onAir="0" premiere="0" videoResolution="720" origin="livetv"/><Media beginsAt="1781214459" duration="3071000" endsAt="1781217530" id="6a2218f07845c0e000edc5c7" onAir="0" premiere="0" videoResolution="720" origin="livetv"/></Video><Video guid="plex://episode/6a2218ef7845c0e000edc5b2" key="/library/metadata/6a2218ef7845c0e000edc5b2" ratingKey="6a2218e