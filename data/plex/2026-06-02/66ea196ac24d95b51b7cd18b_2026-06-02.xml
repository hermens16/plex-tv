080/3/1672730.jpg" grandparentGuid="plex://show/69b0b83aba3a6d319e0e710b" grandparentKey="/library/metadata/69b0b83aba3a6d319e0e710b" grandparentRatingKey="69b0b83aba3a6d319e0e710b" grandparentThumb="https://cdn-images.watch4.com/1920/2/1672730.jpg" grandparentTitle="Te Tengo en Salsa" grandparentType="show" index="78" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://cdn-images.watch4.com/1080/3/1672730.jpg" title="S01:E78" userState="0"><Image alt="S01:E78" type="coverArt" url="https://cdn-images.watch4.com/1080/3/1672730.jpg"/><Image alt="S01:E78" type="coverPoster" url="https://cdn-images.watch4.com/1920/2/1672730.jpg"/><Image alt="S01:E78" type="snapshot" url="https://cdn-images.watch4.com/1080/3/1672730.jpg"/><Genre filter="genre=6a0c2728768cf9b31f6fe02a" id="6a0c2728768cf9b31f6fe02a" key="/library/sections/home/all?genre=6a0c2728768cf9b31f6fe02a" ratingKey="genre_6a0c2728768cf9b31f6fe02a" slug="bingeworthy" tag="Bingeworthy" type="directory" context="tag.genre"/><Genre filter="genre=6006cc18610ee2002c74f2fe" id="6006cc18610ee2002c74f2fe" key="/library/sections/home/all?genre=6006cc18610ee2002c74f2fe" ratingKey="genre_6006cc18610ee2002c74f2fe" slug="drama" tag="Drama" type="directory" context="tag.genre"/><Media beginsAt="1780394340" duration="3087000" endsAt="1780397427" id="6a1592be14852a6ff86d748a" onAir="0" premiere="0" videoResolution="720" origin="livetv"/><Media beginsAt="1780424136" duration="3086000" endsAt="1780427222" id="6a1592be14852a6ff86d7494" onAir="0" premiere="0" videoResolution="720" origin="livetv"/></Video><Video guid="plex://episode/6a1592bd14852a6ff86d747c" key="/library/metadata/6a1592bd14852a6ff86d747c" ratingKey="6a1592bd14852a6ff86d747c" summary="Nicolás Del Casal quiere dejar los continuos enfrentamientos con Victoria Guanipa, quien asegura que eso solo podría pasar si él acepta venderle la hacienda Los Samanes porque, de lo contrario, ella seguirá tratando de quitarle todos los negocios posibles hasta que a él no le quede más remedio que rematar la hacienda. Con la excusa de que quiere ganarse la confianza de su padre Leopoldo Alcoy, Federico busca a Hansen con la intención de pedirle un préstamo para hacer un negocio; el joven, que se molesta cuando el empresario se niega a apoyarlo por considerar que el trato que le ofrecieron es una estafa, sentencia que va a convertirse en un hombre millonario por cuenta propia. Cansada de que Victoria insista en atacar a su sobrino Nicolás, Fernanda de Alcoy advierte a Florencia que ellas deberán encargarse de que la joven Guanipa pierda su hacienda Cantarrana; la joven señora Del Casal considera que ella sola puede encargase de enfrentar a su rival sin que su tía política se involucre." type="episode" contentRating="NONADULT" duration="3059000" grandparentArt="https://cdn-images.watch4.com/1080/3/1766385.jpg" grandparentGuid="plex://show/67a0b759cb3d68c83b1e7d4f" grandparentKey="/library/metadata/67a0b759cb3d68c83b1e7d4f" grandparentRatingKey="67a0b759cb3d68c83b1e7d4f" grandparentThumb="https://cdn-images.watch4.com/1920/2/1766385.jpg" grandparentTitle="La Trepadora" grandparentType="show" index="96" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://cdn-images.watch4.com/1080/3/1766385.jpg" title="S01:E096" userState="0"><Image alt="S01:E096" type="coverArt" url="https://cdn-images.watch4.com/1080/3/1766385.jpg"/><Image alt="S01:E096" type="coverPoster" url="https://cdn-images.watch4.com/1920/2/1766385.jpg"/><Image alt="S01:E096" type="snapshot" url="https://cdn-images.watch4.com/1080/3/1766385.jpg"/><Genre filter="genre=6a0c2728768cf9b31f6fe02a" id="6a0c2728768cf9b31f6fe02a" key="/library/sections/home/all?genre=6a0c2728768cf9b31f6fe02a" ratingKey="genre_6a0c2728768cf9b31f6fe02a" slug="bingeworthy" tag="Bingeworthy" type="directory" context="tag.genre"/><Genre filter="genre=6006cc18610ee2002c74f2fe" id="6006cc18610ee2002c74f2fe" key="/library/sections/home/all?genre=6006cc18610ee2002c74f2fe" ratingKey="genre_6006cc18610e