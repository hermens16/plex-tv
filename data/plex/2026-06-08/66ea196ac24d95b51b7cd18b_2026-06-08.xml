" grandparentGuid="plex://show/69d79cef6ad16397528a860a" grandparentKey="/library/metadata/69d79cef6ad16397528a860a" grandparentRatingKey="69d79cef6ad16397528a860a" grandparentThumb="https://cdn-images.watch4.com/1920/2/1672731.jpg" grandparentTitle="El Desprecio" grandparentType="show" index="53" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://cdn-images.watch4.com/1080/3/1672731.jpg" title="S01:E53" userState="0"><Image alt="S01:E53" type="coverArt" url="https://cdn-images.watch4.com/1080/3/1672731.jpg"/><Image alt="S01:E53" type="coverPoster" url="https://cdn-images.watch4.com/1920/2/1672731.jpg"/><Image alt="S01:E53" type="snapshot" url="https://cdn-images.watch4.com/1080/3/1672731.jpg"/><Genre filter="genre=6a0c2728768cf9b31f6fe02a" id="6a0c2728768cf9b31f6fe02a" key="/library/sections/home/all?genre=6a0c2728768cf9b31f6fe02a" ratingKey="genre_6a0c2728768cf9b31f6fe02a" slug="bingeworthy" tag="Bingeworthy" type="directory" context="tag.genre"/><Media beginsAt="1780881148" duration="2605000" endsAt="1780883753" id="6a1c2a3736898ddd3cb48278" onAir="0" premiere="0" videoResolution="720" origin="livetv"/><Media beginsAt="1780904948" duration="2606000" endsAt="1780907554" id="6a1d7c1dbe2d3e676855bfae" onAir="0" premiere="0" videoResolution="720" origin="livetv"/><Media beginsAt="1780934713" duration="2471000" endsAt="1780937184" id="6a1d7c1dbe2d3e676855bfb8" onAir="0" premiere="0" videoResolution="720" origin="livetv"/></Video><Video guid="plex://episode/6a1c2a3636898ddd3cb48257" key="/library/metadata/6a1c2a3636898ddd3cb48257" ratingKey="6a1c2a3636898ddd3cb48257" summary="Frente a Hilario Guanipa, su hija Victoria y Genara, Felipe Osuna informa a Adelaida de Guanipa que Carlos Hansen sufrió un accidente, pero sigue con vida; el joven Osuna quiere darle a la señora un mensaje que su jefe le envió antes de lo ocurrido, pero la mujer, aturdida, sale corriendo de su casa sin escucharlo; Hilario ordena a todos que le dejen tranquila. Sintiéndose culpable, Adelaida llora desconsolada creyendo a su amado Hansen en peligro de muerte cuando el hombre se aparece ante ella sano y salvo explicándole que todo fue una trampa que montó para distraer la vigilancia de Hilario y poder sacarla de la hacienda. Fernanda de Alcoy avisa a Florencia que ya tiene casi todo cuadrado para lo que van a hacer en contra de Victoria; Fernanda, quien se enteró de que Victoria botó a su padre de su casa, avisa a Florencia que deben aprovechar esa oportunidad para llevar a cabo su plan contra la joven Guanipa y que toda la culpa recaiga sobre Hilario; la joven señora Del Casal le pide a su tía política le dé dos días para prepararse para el evento." type="episode" contentRating="NONADULT" duration="3077000" grandparentArt="https://cdn-images.watch4.com/1080/3/1766385.jpg" grandparentGuid="plex://show/67a0b759cb3d68c83b1e7d4f" grandparentKey="/library/metadata/67a0b759cb3d68c83b1e7d4f" grandparentRatingKey="67a0b759cb3d68c83b1e7d4f" grandparentThumb="https://cdn-images.watch4.com/1920/2/1766385.jpg" grandparentTitle="La Trepadora" grandparentType="show" index="100" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://cdn-images.watch4.com/1080/3/1766385.jpg" title="S01:E100" userState="0"><Image alt="S01:E100" type="coverArt" url="https://cdn-images.watch4.com/1080/3/1766385.jpg"/><Image alt="S01:E100" type="coverPoster" url="https://cdn-images.watch4.com/1920/2/1766385.jpg"/><Image alt="S01:E100" type="snapshot" url="https://cdn-images.watch4.com/1080/3/1766385.jpg"/><Genre filter="genre=6a0c2728768cf9b31f6fe02a" id="6a0c2728768cf9b31f6fe02a" key="/library/sections/home/all?genre=6a0c2728768cf9b31f6fe02a" ratingKey="genre_6a0c2728768cf9b31f6fe02a" slug="bingeworthy" tag="Bingeworthy" type="directory" context="tag.genre"/><Media beginsAt="1780922151" duration="3077000" endsAt="1780925228" id="6a1d7c1dbe2d3e676855bfb4" onAir="0" premiere="0" videoResolution="720" origin="livetv"/><Media beginsAt="1780952305" duration="3077000" endsAt