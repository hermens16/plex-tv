o><Video guid="plex://episode/6a1d7c18be2d3e676855bfa0" key="/library/metadata/6a1d7c18be2d3e676855bfa0" ratingKey="6a1d7c18be2d3e676855bfa0" summary="Alberto llega al parque donde está Lorena con Norma e Ignacio. A él le parece que ya es tiempo del perdón y le cuenta lo que hizo con Claudio y Gertrudis, siguiendo el consejo que ella misma le dio; ahora se siente aliviado y listo para continuar. Alberto, arrodillado ante ella, le propone matrimonio a Lorena con un anillo en sus manos. Ella acepta feliz. “El que perdona la ofensa, cultiva el amor…” Fin." type="episode" contentRating="NONADULT" duration="3271000" grandparentArt="https://cdn-images.watch4.com/1080/3/1673084.jpg" grandparentGuid="plex://show/68bad9a39aa661c3574d4960" grandparentKey="/library/metadata/68bad9a39aa661c3574d4960" grandparentRatingKey="68bad9a39aa661c3574d4960" grandparentThumb="https://cdn-images.watch4.com/1920/2/1673084.jpg" grandparentTitle="Corazon Traicionado" grandparentType="show" index="120" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://cdn-images.watch4.com/1080/3/1673084.jpg" title="Corazón Traicionado - S01:E120" userState="0"><Image alt="Corazón Traicionado - S01:E120" type="coverArt" url="https://cdn-images.watch4.com/1080/3/1673084.jpg"/><Image alt="Corazón Traicionado - S01:E120" type="coverPoster" url="https://cdn-images.watch4.com/1920/2/1673084.jpg"/><Image alt="Corazón Traicionado - S01:E120" type="snapshot" url="https://cdn-images.watch4.com/1080/3/1673084.jpg"/><Genre filter="genre=6a0c2728768cf9b31f6fe02a" id="6a0c2728768cf9b31f6fe02a" key="/library/sections/home/all?genre=6a0c2728768cf9b31f6fe02a" ratingKey="genre_6a0c2728768cf9b31f6fe02a" slug="bingeworthy" tag="Bingeworthy" type="directory" context="tag.genre"/><Media beginsAt="1780901677" duration="3271000" endsAt="1780904948" id="6a1d7c1dbe2d3e676855bfad" onAir="0" premiere="0" videoResolution="720" origin="livetv"/><Media beginsAt="1780931442" duration="3271000" endsAt="1780934713" id="6a1d7c1dbe2d3e676855bfb7" onAir="0" premiere="0" videoResolution="720" origin="livetv"/><Media beginsAt="1780961730" duration="3271000" endsAt="1780965001" id="6a1d7c1dbe2d3e676855bfc1" onAir="0" premiere="0" videoResolution="720" origin="livetv"/></Video><Video guid="plex://episode/6a1d7c19be2d3e676855bfa1" key="/library/metadata/6a1d7c19be2d3e676855bfa1" ratingKey="6a1d7c19be2d3e676855bfa1" summary="Delante de Elisenda, Pastora deja al descubierto que Misael siempre ha sido especial para ella; Israel lo ha retado a muerte." type="episode" contentRating="NONADULT" duration="2201000" grandparentArt="https://cdn-images.watch4.com/1080/3/1672731.jpg" grandparentGuid="plex://show/69d79cef6ad16397528a860a" grandparentKey="/library/metadata/69d79cef6ad16397528a860a" grandparentRatingKey="69d79cef6ad16397528a860a" grandparentThumb="https://cdn-images.watch4.com/1920/2/1672731.jpg" grandparentTitle="El Desprecio" grandparentType="show" index="54" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://cdn-images.watch4.com/1080/3/1672731.jpg" title="S01:E54" userState="0"><Image alt="S01:E54" type="coverArt" url="https://cdn-images.watch4.com/1080/3/1672731.jpg"/><Image alt="S01:E54" type="coverPoster" url="https://cdn-images.watch4.com/1920/2/1672731.jpg"/><Image alt="S01:E54" type="snapshot" url="https://cdn-images.watch4.com/1080/3/1672731.jpg"/><Genre filter="genre=6a0c2728768cf9b31f6fe02a" id="6a0c2728768cf9b31f6fe02a" key="/library/sections/home/all?genre=6a0c2728768cf9b31f6fe02a" ratingKey="genre_6a0c2728768cf9b31f6fe02a" slug="bingeworthy" tag="Bingeworthy" type="directory" context="tag.genre"/><Media beginsAt="1780907554" duration="2201000" endsAt="1780909755" id="6a1d7c1dbe2d3e676855bfaf" onAir="0" premiere="0" videoResolution="720" origin="livetv"/><Media beginsAt="1780937184" duration="2591000" endsAt="1780939775" id="6a1d7c1dbe2d3e676855bfb9" onAir="0" premiere="0" videoResolution="720" origin="livetv"/></Video><Video guid="plex://episode/6a1d7c1bbe2d3e676855bfa2" key="/library/metadata/6a1d7c1bbe2d3e676855bfa2" ratingKey="6a1d7c1bbe2d3e676855bfa2" summary="Para decidir quién comprará las yeguas, Florencia reta a Victoria a una carrera por el llano donde la ganadora se quedará con los animales; Victoria acepta el desafío. Una inesperada visita de Hilario asusta a Federico, mientras que Fernanda no se amilana y le recuerda a su medio hermano que Victoria es quien lo está dejando en la ruina; Hilario le asegura a Fernanda que no permitirá que su propia hija lo despoje de lo que le pertenece. En medio de la carrera, Florencia desenfunda su arma y dispara al viento para obligar a Victoria a detenerse; esta última se extraña al ver a la señora Del Casal armada, dispuesta a matar, pero Florencia es incapaz de seguir su plan, por lo que decide terminar la carrera. Frente a un confundido Nicolás, Victoria irrumpe en la hacienda Los Samanes para exigirle a Florencia una explicación sobre el por qué ésta cavó una fosa cerca del lugar donde disparó durante la carrera: debido a que Florencia niega su participación en la excavación, Victoria arremete en contra de ella para que confiese su intención de asesinarla." type="episode" contentRating="NONADULT" duration="3077000" grandparentArt="https://cdn-images.watch4.com/1080/3/1766385.jpg" grandparentGuid="plex://show/67a0b759cb3d68c83b1e7d4f" grandparentKey="/library/metadata/67a0b759cb3d68c83b1e7d4f" grandparentRatingKey="67a0b759cb3d68c83b1e7d4f" grandparentThumb="https://cdn-images.watch4.com/1920/2/1766385.jpg" grandparentTitle="La Trepadora" grandparentType="show" index="101" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://cdn-images.watch4.com/1080/3/1766385.jpg" title="S01:E101" userState="0"><Image alt="S01:E101" type="coverArt" url="https://cdn-images.watch4.com/1080/3/1766385.jpg"/><Image alt="S01:E101" type="coverPoster" url="https://cdn-images.watch4.com/1920/2/1766385.jpg"/><Image alt="S01:E101" type="snapshot" url="https://cdn-images.watch4.com/1080/3