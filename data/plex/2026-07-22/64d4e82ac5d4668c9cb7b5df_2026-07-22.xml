creen/3840x2160/vpda-thum-wide.jpg" grandparentGuid="plex://show/6a3c783f1c9ab3c10e21a9c7" grandparentKey="/library/metadata/6a3c783f1c9ab3c10e21a9c7" grandparentRatingKey="6a3c783f1c9ab3c10e21a9c7" grandparentThumb="https://provider-static.plex.tv/epg/cms/production/f0264004-d833-4809-8173-dc12f75e70e0/Novelisima_vert_2000x3000_-_Ali_Clausen.jpg" grandparentTitle="Pecado de Amor" grandparentType="show" index="15" originallyAvailableAt="2026-06-16T00:00:00Z" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://img.static-ottera.com/prod/cis/video/thumbnails/widescreen/3840x2160/vpda-thum-wide.jpg" title="Episodio 15" userState="0" year="2026"><Image alt="Episodio 15" type="coverArt" url="https://img.static-ottera.com/prod/cis/video/thumbnails/widescreen/3840x2160/vpda-thum-wide.jpg"/><Image alt="Episodio 15" type="coverPoster" url="https://provider-static.plex.tv/epg/cms/production/f0264004-d833-4809-8173-dc12f75e70e0/Novelisima_vert_2000x3000_-_Ali_Clausen.jpg"/><Image alt="Episodio 15" type="snapshot" url="https://img.static-ottera.com/prod/cis/video/thumbnails/widescreen/3840x2160/vpda-thum-wide.jpg"/><Genre filter="genre=6171e01d4c451f5a44debdf6" id="6171e01d4c451f5a44debdf6" key="/library/sections/home/all?genre=6171e01d4c451f5a44debdf6" ratingKey="genre_6171e01d4c451f5a44debdf6" slug="en-espanol" tag="En Español" type="directory" context="tag.genre"/><Media beginsAt="1784689200" duration="3600000" endsAt="1784692800" id="6a56d5f1c07ffd26d7146c59" live="0" onAir="0" premiere="0" videoResolution="720" origin="livetv"/><Media beginsAt="1784710800" duration="3600000" endsAt="1784714400" id="6a56d5f1c07ffd26d7146c5f" live="0" onAir="0" premiere="0" videoResolution="720" origin="livetv"/><Media beginsAt="1784732400" duration="3600000" endsAt="1784736000" id="6a56d5f1c07ffd26d7146c65" live="0" onAir="0" premiere="0" videoResolution="720" origin="livetv"/><Media beginsAt="1784754000" duration="3600000" endsAt="1784757600" id="6a56d5f1c07ffd26d7146c6b" live="0" onAir="0" premiere="0" videoResolution="720" origin="livetv"/></Video><Video guid="plex://episode/6a56d5edc07ffd26d7146c49" key="/library/metadata/6a56d5edc07ffd26d7146c49" ratingKey="6a56d5edc07ffd26d7146c49" summary="Virginia le confirma a su madre, Trinidad, de que va a trabajar en Ferrándiz. Trinidad no lo acepta de ninguna manera. Rebeca se cura gracias a la asistencia de Irene, que, a su vez se reconcilia con Leonardo. La señora Jimena se entera por su hijo que Virginia va a trabajar en la empresa, reniega de eso y va a solicitar un impedimento legal para que ella no se pueda acercar a su familia. Julio se pelea con su hermano Leonardo por causa del embarazo supuestamente falso de Oriana y le cuenta a su padre que Leonardo se reconcilió con María Lucía. Virginia se encuentra en la oficina con Rodrigo, alguien del pasado, que trata de abusar de ella. María Lucía, que se había reconciliado con Leonardo, queda desilusionada por la pelea que él tuvo con Ricardo." type="episode" contentRating="M/16" duration="3600000" grandparentArt="https://img.static-ottera.com/prod/cis/video/thumbnails/widescreen/3840x2160/vase-thum-wide.jpg" grandparentGuid="plex://show/69cdb9ff318ee9230cc5ccf2" grandparentKey="/library/metadata/69cdb9ff318ee9230cc5ccf2" grandparentRatingKey="69cdb9ff318ee9230cc5ccf2" grandparentThumb="https://provider-static.plex.tv/epg/cms/production/f0264004-d833-4809-8173-dc12f75e70e0/Novelisima_vert_2000x3000_-_Ali_Clausen.jpg" grandparentTitle="Amor Secreto" grandparentType="show" index="71" originallyAvailableAt="2026-06-16T00:00:00Z" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://img.static-ottera.com/prod/cis/video/thumbnails/widescreen/3840x2160/vase-thum-wide.jpg" title="Episodio 75" userState="0" year="2026"><Image alt="Episodio 75" type="coverArt" url="https://img.static-ottera.com/prod/cis/video/thumbnails/widescreen/3840x2160/vase-thum-wide.jpg"/><Image alt="Episodio 75" type="coverPoster" url="https://provider-static.ple