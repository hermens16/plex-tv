<MediaContainer offset="0" totalSize="13" identifier="tv.plex.provider.epg" size="13"><Video guid="plex://episode/6a2ff13fbe0e9e5bf47b046d" key="/library/metadata/6a2ff13fbe0e9e5bf47b046d" ratingKey="6a2ff13fbe0e9e5bf47b046d" summary="Max detenido y Camila asegura que es inocente. Santiago le cuenta al inspector haber visto a Max limpiando el objeto con el que mataron a Ezequiel y, con tristeza concluye que él y Camila fueron los autores. Continúan los interrogatorios." type="episode" contentRating="NONADULT" duration="3175000" grandparentArt="https://cdn-images.watch4.com/1080/3/1672724.jpg" grandparentGuid="plex://show/66ea19708651b52ba9cee047" grandparentKey="/library/metadata/66ea19708651b52ba9cee047" grandparentRatingKey="66ea19708651b52ba9cee047" grandparentThumb="https://cdn-images.watch4.com/1920/2/1672724.jpg" grandparentTitle="Piel Salvaje" grandparentType="show" index="117" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://cdn-images.watch4.com/1080/3/1672724.jpg" title="S01:E117" userState="0"><Image alt="S01:E117" type="coverArt" url="https://cdn-images.watch4.com/1080/3/1672724.jpg"/><Image alt="S01:E117" type="coverPoster" url="https://cdn-images.watch4.com/1920/2/1672724.jpg"/><Image alt="S01:E117" type="snapshot" url="https://cdn-images.watch4.com/1080/3/1672724.jpg"/><Genre filter="genre=6a0c2728768cf9b31f6fe02a" id="6a0c2728768cf9b31f6fe02a" key="/library/sections/home/all?genre=6a0c2728768cf9b31f6fe02a" ratingKey="genre_6a0c2728768cf9b31f6fe02a" slug="bingeworthy" tag="Bingeworthy" type="directory" context="tag.genre"/><Media beginsAt="1782358926" duration="2780000" endsAt="1782361706" id="6a3293fb5bd14c876b0e379f" onAir="0" premiere="0" videoResolution="720" origin="livetv"/></Video><Video guid="plex://episode/6a31eb1d1d3d35f8271c722a" key="/library/metadata/6a31eb1d1d3d35f8271c722a" ratingKey="6a31eb1d1d3d35f8271c722a" summary="César Román desea felicidad a los nuevos esposos, pero Santiago -la nota discordante- al brindar por u