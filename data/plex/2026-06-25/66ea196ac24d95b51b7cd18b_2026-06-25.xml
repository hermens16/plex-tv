ibrary/metadata/67e89127191c82b2c18c3e69" grandparentRatingKey="67e89127191c82b2c18c3e69" grandparentThumb="https://cdn-images.watch4.com/1920/2/1672545-portrait.jpg" grandparentTitle="272" grandparentType="show" index="119" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://cdn-images.watch4.com/1080/3/1672546-landscape.jpg" title="Piel Salvaje - S01:E119" userState="0"><Image alt="Piel Salvaje - S01:E119" type="coverArt" url="https://cdn-images.watch4.com/1080/1/1672545-thumb.jpg"/><Image alt="Piel Salvaje - S01:E119" type="coverPoster" url="https://cdn-images.watch4.com/1920/2/1672545-portrait.jpg"/><Image alt="Piel Salvaje - S01:E119" type="snapshot" url="https://cdn-images.watch4.com/1080/3/1672546-landscape.jpg"/><Genre filter="genre=6a0c2728768cf9b31f6fe02a" id="6a0c2728768cf9b31f6fe02a" key="/library/sections/home/all?genre=6a0c2728768cf9b31f6fe02a" ratingKey="genre_6a0c2728768cf9b31f6fe02a" slug="bingeworthy" tag="Bingeworthy" type="directory" context="tag.genre"/><Media beginsAt="1782364464" duration="2743000" endsAt="1782367207" id="6a3293fb5bd14c876b0e37a1" onAir="0" premiere="0" videoResolution="720" origin="livetv"/><Media beginsAt="1782388154" duration="3114000" endsAt="1782391268" id="6a33e5ba0762c902a0f909dd" onAir="0" premiere="0" videoResolution="720" origin="livetv"/><Media beginsAt="1782418517" duration="3113000" endsAt="1782421630" id="6a33e5ba0762c902a0f909e7" onAir="0" premiere="0" videoResolution="720" origin="livetv"/></Video><Video guid="plex://episode/6a3293f95bd14c876b0e377c" key="/library/metadata/6a3293f95bd14c876b0e377c" ratingKey="6a3293f95bd14c876b0e377c" summary="Convencida de que su hijo cumplió con su parte del trato en la guerra contra los Guanipa, Fernanda le pide a Federico regresar a la capital, pero el joven Alcoy no se marchará de la hacienda no sin antes conseguir sus objetivos. En medio de una cena romántica, Nicolás no tiene ninguna duda de que Victoria Guanipa será su esposa; una enamorada Victoria lo besa. Después de una noche junto a Nicolás, Victoria se siente culpable de amar a un hombre que espera un hijo de Florencia. A escondidas, Genara escucha cuando Sergio lamenta haber perdido la oportunidad de matar a Nicolás. Por su parte, Nicolás se desahoga con su tío, pues – a pesar de no estar enamorado de Florencia - Nicolás necesita que la madre de su hijo sea feliz. Justo cuando Sergio toma del brazo a Genara para asegurarse de que la chica no lo haya escuchado, Federico defiende a Genara; una vez a solas con el joven Alcoy, Genara le pide no acercarse más a ella, pues su vida corre peligro ahora que está en medio de la guerra entre los Del Casal y los Guanipa." type="episode" contentRating="NONADULT" duration="3048000" grandparentArt="https://cdn-images.watch4.com/1080/3/1766385.jpg" grandparentGuid="plex://show/67a0b759cb3d68c83b1e7d4f" grandparentKey="/library/metadata/67a0b759cb3d68c83b1e7d4f" grandparentRatingKey="67a0b759cb3d68c83b1e7d4f" grandparentThumb="https://cdn-images.watch4.com/1920/2/1766385.jpg" grandparentTitle="La Trepadora" grandparentType="show" index="119" parentIndex="1" requiresConsent="1" skipParent="1" thumb="https://cdn-images.watch4.com/1080/3/1766385.jpg" title="S01:E119" userState="0"><Image alt="S01:E119" type="coverArt" url="https://cdn-images.watch4.com/1080/3/1766385.jpg"/><Image alt="S01:E119" type="coverPoster" url="https://cdn-images.watch4.com/1920/2/1766385.jpg"/><Image alt="S01:E119" type="snapshot" url="https://cdn-images.watch4.com/1080/3/1766385.jpg"/><Genre filter="genre=6a0c2728768cf9b31f6fe02a" id="6a0c2728768cf9b31f6fe02a" key="/library/sections/home/all?genre=6a0c2728768cf9b31f6fe02a" ratingKey="genre_6a0c2728768cf9b31f6fe02a" slug="bingeworthy" tag="Bingeworthy" type="directory" context="tag.genre"/><Media beginsAt="1782391268" duration="3048000" endsAt="1782394316" id="6a33e5ba0762c902a0f909de" onAir="0" premiere="0" videoResolution="720" origin="livetv"/><Media beginsAt="1782421630" duration="3048000" endsAt="1782